[core]
    autocrlf = false
[init]
    defaultBranch = main
[user]
    name = mkizka
    email = git@mkizka.net
[alias]
    prune-branches = !git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
